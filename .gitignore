# The snapshot and the big intermediates. Gigabytes, and never modified once written.
data/raw/
data/interim/

# data/processed/contributors.parquet IS committed (24 MB). It is the table frozen at
# HUMAN GATE 2, and since data/raw/ is not in git and upstream drops snapshots after
# about a week, it is the only way a clone can rerun M5 onward.

# out/ IS committed for the same reason: results.json and the figures are what the
# report quotes, they total under 300 KB, and they cannot be regenerated from a clone
# without the raw snapshot.

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.nav
*.snm
*.toc
paper/report.pdf
slide/slide.pdf

__pycache__/
.venv/
